# Public TEST keys from hCaptcha (always pass, documented at docs.hcaptcha.com).
# Not a secret - they only let the widget work without a real account.
# In production, replace with your site's keys (sitekey from the hCaptcha
# dashboard, secret NEVER committed).
HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000
PORT=3000

# Optional - defense in depth. If set, the backend rejects tokens whose
# "hostname" returned by siteverify does not match this value.
# Leave empty in local dev.
# HCAPTCHA_EXPECTED_HOSTNAME=app.yourdomain.com

# Optional - only set this if the server is behind a reverse proxy/load
# balancer/CDN (e.g. Nginx, ALB, Cloudflare). Controls how many
# X-Forwarded-For "hops" Express should trust to get the real client IP
# (used for rate limiting). Leave empty in local dev.
# TRUST_PROXY=1
